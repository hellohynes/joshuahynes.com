{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/only-export-components": [
      "error",
      {
        "allowConstantExport": true
      }
    ],
    "typescript/no-explicit-any": "error"
  },
  "ignorePatterns": [
    "dist",
    "backup"
  ]
}
